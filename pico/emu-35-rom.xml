<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- The manifest file based on emu-35-6-release -->
  <include name="pico/emu-35-6-release.xml" />
  <remove-project name="platform/external/qemu" />
  <remove-project name="platform/hardware/google/aemu" />
  <remove-project name="platform/hardware/google/gfxstream" />
  <remove-project name="platform/prebuilts/android-emulator-build/common" />

  <!-- Pull the modified repositories from the pico branch -->
  <remote fetch="https://github.com/Pico-Developer" name="origin" />
  <project path="external/qemu" name="PICO-Emulator-qemu.git" remote="origin" revision="main">
    <copyfile src="android/vscode/emu.code-workspace" dest="emu.code-workspace" />
  </project>
  <project path="hardware/google/aemu" name="PICO-Emulator-aemu.git" remote="origin" revision="main" />
  <project path="hardware/google/gfxstream" name="PICO-Emulator-gfxstream.git" remote="origin" revision="main" />
  <project path="prebuilts/android-emulator-build/common" name="PICO-Emulator-common.git" remote="origin" revision="main" lfs="true" />
</manifest>
